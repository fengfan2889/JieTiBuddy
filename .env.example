# ===== 复制为 server/.env 后填写真实值，.env 已被 .gitignore 忽略 =====

# 服务端口
PORT=8787

# 数据库（MVP 用 SQLite 文件，零部署成本）
DATABASE_URL=./data/jietibuddy.sqlite

# ===== 多模态大模型（D2：通义千问-VL / DashScope）=====
# 供应商：qwen | openai
LLM_PROVIDER=qwen
# 在 https://bailian.console.aliyun.com/ 申请
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
QWEN_VL_MODEL=qwen-vl-max
QWEN_TEXT_MODEL=qwen-plus

# ===== 备选供应商（可选，留空则不启用）=====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VL_MODEL=gpt-4o

# ===== 调试 =====
# 1 = 把发给模型的完整提示词打到日志（排查引导质量用）
DEBUG_PROMPT=0
LOG_LEVEL=info
